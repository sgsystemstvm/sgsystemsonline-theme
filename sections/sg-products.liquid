<section class="sg-section"><div class="sg-container"><div class="sg-section-head"><h2>{{ section.settings.title }}</h2>{% if section.settings.collection != blank %}<a class="sg-view" href="{{ section.settings.collection.url }}">View All →</a>{% endif %}</div><div class="sg-products">{% assign products = section.settings.collection.products | default: collections.all.products %}{% for product in products limit: section.settings.limit %}<article class="sg-card"><a href="{{ product.url }}"><div class="sg-card-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%;height:100%;object-fit:contain;' }}{% else %}PRODUCT IMAGE{% endif %}</div><div class="sg-card-body"><div class="sg-card-title">{{ product.title }}</div><div class="sg-price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<span class="sg-old">{{ product.compare_at_price | money }}</span>{% endif %}</div>{% if product.compare_at_price > product.price %}<div class="sg-discount">Sale</div>{% endif %}</div></a></article>{% else %}{% for i in (1..5) %}<article class="sg-card"><div class="sg-card-image">Add products to your collection</div><div class="sg-card-body"><div class="sg-card-title">Your product will appear here</div></div></article>{% endfor %}{% endfor %}</div></div></section>
{% schema %}{"name":"SG Products","settings":[{"type":"text","id":"title","label":"Title","default":"Best Sellers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":4,"max":10,"step":1,"default":5}],"presets":[{"name":"SG Products"}]}{% endschema %}
