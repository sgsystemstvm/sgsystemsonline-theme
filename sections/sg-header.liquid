<header class="sg-header">
  <div class="sg-container">
    <a class="sg-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'sg-logo', loading: 'eager' }}
      {% else %}
        <div class="sg-logo-fallback"><b>SG</b><strong>SYSTEMS<span>ONLINE</span></strong><small>SMART PRODUCTS. SMART PRICES.</small></div>
      {% endif %}
    </a>
    <form class="sg-search" action="{{ routes.search_url }}" method="get">
      <select name="type" aria-label="Search type"><option value="product">All Categories</option></select>
      <input type="search" name="q" placeholder="Search for products..." value="{{ search.terms | escape }}">
      <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg></button>
    </form>
    <div class="sg-actions">
      <a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c.7-4 3.4-6 8-6s7.3 2 8 6"></path></svg><span>My Account</span></a>
      <a href="{{ routes.cart_url }}" class="sg-cart-link"><span class="sg-cart-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2 12h10l3-9H6"></path><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"></circle></svg>{% if cart.item_count > 0 %}<em>{{ cart.item_count }}</em>{% endif %}</span><span>My Cart</span></a>
    </div>
  </div>
</header>
{% schema %}{"name":"SG Header","settings":[{"type":"image_picker","id":"logo","label":"Logo"}],"presets":[{"name":"SG Header"}]}{% endschema %}