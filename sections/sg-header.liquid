<header class="sg-header"><div class="sg-container"><a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 600 | image_tag: class: 'sg-logo', loading: 'eager' }}{% else %}<div class="sg-logo" style="font-size:30px;font-weight:800;color:#1260d8">SG<span style="color:#071a3d">SYSTEMS</span><span>ONLINE</span></div>{% endif %}</a><form class="sg-search" action="{{ routes.search_url }}" method="get"><select name="type" aria-label="Search type"><option value="product">All Categories</option></select><input type="search" name="q" placeholder="Search for products..." value="{{ search.terms | escape }}"><button type="submit" aria-label="Search">⌕</button></form><div class="sg-actions"><a href="{{ routes.account_url }}">♙ &nbsp;My Account</a><a href="{{ routes.cart_url }}">🛒 &nbsp;My Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a></div></div></header>
{% schema %}{"name":"SG Header","settings":[{"type":"image_picker","id":"logo","label":"Logo"}],"presets":[{"name":"SG Header"}]}{% endschema %}
