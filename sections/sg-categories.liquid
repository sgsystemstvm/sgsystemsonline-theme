<section class="sg-container sg-strip"><div class="sg-categories">{% for block in section.blocks %}<div class="sg-category" {{ block.shopify_attributes }}><div class="sg-category-image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 220 | image_tag: loading: 'lazy' }}{% else %}<span class="sg-cat-symbol">{{ block.settings.symbol }}</span>{% endif %}</div><div><strong>{{ block.settings.title }}</strong><a href="{{ block.settings.link }}">Explore Now →</a></div></div>{% endfor %}</div></section>
{% schema %}{"name":"SG Categories","max_blocks":4,"blocks":[{"type":"category","name":"Category","settings":[{"type":"text","id":"title","label":"Title","default":"Electronics"},{"type":"text","id":"symbol","label":"Fallback symbol","default":"◉"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"SG Categories","blocks":[{"type":"category","settings":{"title":"Electronics","symbol":"◉"}},{"type":"category","settings":{"title":"Home & Kitchen","symbol":"▣"}},{"type":"category","settings":{"title":"Travel Essentials","symbol":"▤"}},{"type":"category","settings":{"title":"Fitness & Health","symbol":"◌"}}]}]}{% endschema %}
