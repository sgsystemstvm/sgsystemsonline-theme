<section class="sg-container sg-strip"><div class="sg-categories">{% for block in section.blocks %}{% assign cat_asset = 'sg-cat-electronics.svg' %}{% if block.settings.title contains 'Kitchen' %}{% assign cat_asset = 'sg-cat-kitchen.svg' %}{% elsif block.settings.title contains 'Travel' %}{% assign cat_asset = 'sg-cat-travel.svg' %}{% elsif block.settings.title contains 'Fitness' %}{% assign cat_asset = 'sg-cat-fitness.svg' %}{% endif %}<div class="sg-category" {{ block.shopify_attributes }}><div class="sg-category-image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 220 | image_tag: loading: 'lazy' }}{% else %}<img src="{{ cat_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">{% endif %}</div><div><strong>{{ block.settings.title }}</strong><a href="{{ block.settings.link }}">Explore Now →</a></div></div>{% endfor %}</div></section>
{% schema %}{"name":"SG Categories","max_blocks":4,"blocks":[{"type":"category","name":"Category","settings":[{"type":"text","id":"title","label":"Title","default":"Electronics"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"SG Categories","blocks":[{"type":"category","settings":{"title":"Electronics"}},{"type":"category","settings":{"title":"Home & Kitchen"}},{"type":"category","settings":{"title":"Travel Essentials"}},{"type":"category","settings":{"title":"Fitness & Health"}}]}]}{% endschema %}
