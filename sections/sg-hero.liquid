<section class="sg-hero"><div class="sg-container"><div class="sg-hero-copy"><span class="sg-pill">{{ section.settings.badge }}</span><h1>{{ section.settings.heading_1 }}<br><span>{{ section.settings.heading_2 }}</span></h1><p>{{ section.settings.text }}</p><div class="sg-benefits"><div class="sg-benefit">🛡️ <strong>Secure Payments</strong>100% Protected</div><div class="sg-benefit">🚚 <strong>Fast Shipping</strong>Pan India Delivery</div><div class="sg-benefit">📦 <strong>Easy Returns</strong>Hassle Free</div></div><div class="sg-buttons"><a class="sg-btn sg-btn-primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_text }} &nbsp; →</a><a class="sg-btn sg-btn-outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_text }}</a></div></div><div class="sg-hero-art">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', style: 'width:100%;height:auto;object-fit:contain;' }}{% else %}<div class="sg-art-placeholder">Add your hero product artwork in Theme Editor</div>{% endif %}</div></div></section>
{% schema %}{"name":"SG Hero","settings":[{"type":"text","id":"badge","label":"Badge","default":"NEW ARRIVALS"},{"type":"text","id":"heading_1","label":"Heading line 1","default":"Smart Products."},{"type":"text","id":"heading_2","label":"Heading line 2","default":"Smart Prices."},{"type":"textarea","id":"text","label":"Description","default":"Discover innovative products that make your life better, every day."},{"type":"image_picker","id":"image","label":"Hero artwork"},{"type":"text","id":"primary_text","label":"Primary button","default":"SHOP NOW"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_text","label":"Secondary button","default":"EXPLORE COLLECTIONS"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"presets":[{"name":"SG Hero"}]}{% endschema %}
