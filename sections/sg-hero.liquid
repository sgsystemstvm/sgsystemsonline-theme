<section class="sg-hero"><div class="sg-container"><div class="sg-hero-copy"><span class="sg-pill">{{ section.settings.badge }}</span><h1>{{ section.settings.heading_1 }}<br><span>{{ section.settings.heading_2 }}</span></h1><p>{{ section.settings.text }}</p><div class="sg-benefits"><div class="sg-benefit"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3 27 7v8c0 7-4.5 11.5-11 14C9.5 26.5 5 22 5 15V7z"></path><path d="m10 15 4 4 8-8"></path></svg><strong>Secure Payments</strong>100% Protected</div><div class="sg-benefit"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 8h17v14H3zM20 12h5l4 4v6h-9z"></path><circle cx="9" cy="24" r="2"></circle><circle cx="24" cy="24" r="2"></circle></svg><strong>Fast Shipping</strong>Pan India Delivery</div><div class="sg-benefit"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 3 12 7-12 7-12-7z"></path><path d="M4 10v13l12 6 12-6V10M16 17v12"></path></svg><strong>Easy Returns</strong>Hassle Free</div></div><div class="sg-buttons"><a class="sg-btn sg-btn-primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_text }} &nbsp; →</a><a class="sg-btn sg-btn-outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_text }}</a></div></div><div class="sg-hero-art">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: class: 'sg-hero-image', loading: 'eager', widths: '700, 1000, 1200, 1600', sizes: '(min-width: 1000px) 54vw, 100vw' }}{% else %}<img class="sg-hero-image sg-default-hero-art" src="{{ 'sg-hero-art.svg' | asset_url }}" alt="Smart electronics and everyday gadgets" loading="eager">{% endif %}</div></div></section>
{% schema %}{"name":"SG Hero","settings":[{"type":"text","id":"badge","label":"Badge","default":"NEW ARRIVALS"},{"type":"text","id":"heading_1","label":"Heading line 1","default":"Smart Products."},{"type":"text","id":"heading_2","label":"Heading line 2","default":"Smart Prices."},{"type":"textarea","id":"text","label":"Description","default":"Discover innovative products that make your life better, every day."},{"type":"image_picker","id":"image","label":"Hero artwork (optional override)"},{"type":"text","id":"primary_text","label":"Primary button","default":"SHOP NOW"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_text","label":"Secondary button","default":"EXPLORE COLLECTIONS"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"presets":[{"name":"SG Hero"}]}{% endschema %}