<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
    {{ content_for_header }}
    {{ 'sg-theme.css' | asset_url | stylesheet_tag }}
    {{ 'sg-reference-overrides.css' | asset_url | stylesheet_tag }}
    {{ 'mobile-optimization.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-{{ template.name }}">
    {% section 'sg-announcement' %}
    {% section 'sg-header' %}
    {% section 'sg-nav' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'sg-footer' %}
  </body>
</html>